<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-or-later -->
<!-- HatchLens as a Windows service on the host, everything in one process.
     Build: wix build -arch x64 -d Version=X.Y.Z -d Exe=hatchlens.exe -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="HatchLens" Manufacturer="Emmo Emminghaus" Version="$(Version)"
           UpgradeCode="E3AC1559-05D6-41CB-8BA1-BA182C28A430" Scope="perMachine" Compressed="yes">
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of HatchLens is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="HatchLens">
        <Component Id="Service">
          <File Id="Exe" Source="$(Exe)" Name="hatchlens.exe" KeyPath="yes" />
          <ServiceInstall Id="ServiceInstall" Name="HatchLens" DisplayName="HatchLens"
                          Description="Prometheus exporter: Docker volume and directory sizes, image updates, container usage."
                          Type="ownProcess" Start="auto" Account="LocalSystem" ErrorControl="normal" Vital="yes" />
          <ServiceControl Id="ServiceControl" Name="HatchLens" Start="install" Stop="both"
                          Remove="uninstall" Wait="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="Main">
      <ComponentRef Id="Service" />
    </Feature>
  </Package>
</Wix>
